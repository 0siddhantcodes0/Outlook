# Snap Calories server config. Copy this file to server/.env and fill it in.
# server/.env is gitignored; never commit your real key.

# Google AI Studio API key (free tier works): https://aistudio.google.com/apikey
# Without it, /api/scan answers 503 gemini_not_configured.
GEMINI_API_KEY=

# Comma-separated Gemini models, tried in order. The next one is used only when
# a model does not exist (404 / NOT_FOUND), never on rate limits or other errors.
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-2.5-flash

# Port and interface to listen on. 0.0.0.0 lets a phone on the same Wi-Fi connect.
PORT=3001
HOST=0.0.0.0

# SQLite file. Relative paths are resolved from the server/ directory.
DB_PATH=data/calories.db

# Optional shared passcode. When set, every /api route except /api/health needs
# the header "x-app-token: <APP_TOKEN>" (the app asks for it once and remembers it).
APP_TOKEN=

# Set to 1 to use a built-in fake analyzer that always returns the same sample
# meal, for trying the app without a Gemini key.
GEMINI_MOCK=
